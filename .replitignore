# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
/artifacts/dermasense-ai/data/raw/
/artifacts/dermasense-ai/data/processed/
/artifacts/dermasense-ai/outputs/
/artifacts/dermasense-ai/.venv/
/artifacts/dermasense-ai/.pythonlibs/
.pythonlibs/
*.py[cod]
.pytest_cache/
